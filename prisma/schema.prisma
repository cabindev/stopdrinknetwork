generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int       @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String    @unique
  password            String?
  image               String?
  role                Role      @default(member)
  phone               String? // เบอร์ติดต่อ (ให้เพื่อนร่วมพื้นที่ติดต่อได้)
  organization        String? // หน่วยงาน/ประชาคมที่สังกัด
  position            String? // ตำแหน่ง/บทบาทในเครือข่าย
  emailVerified       DateTime?
  resetToken          String?   @unique
  resetTokenCreatedAt DateTime?
  resetTokenExpiresAt DateTime?
  lastPasswordReset   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  activities Activity[]
  auditLogs  AuditLog[]
  teamWorks  ActivityMember[] // งานที่ร่วมเป็นทีม (ไม่ใช่เจ้าของ)
}

enum Role {
  member // เจ้าหน้าที่
  admin
  superadmin
  pending // สมัครใหม่ รอแอดมินอนุมัติ — เห็นแค่ข้อมูลสาธารณะ (ต.ค. 2026)
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// บันทึกการเปลี่ยนแปลงข้อมูล — ใช้อ้างอิงความน่าเชื่อถือของข้อมูล (เช่น ตอนทำงบประมาณ)
model AuditLog {
  id         Int         @id @default(autoincrement())
  action     AuditAction
  entityType String // "Activity" (เผื่อขยายไปโมดูลอื่น)
  entityId   Int
  entityName String // snapshot ชื่องาน ณ ตอนนั้น — ยังอ่านได้แม้ record ถูกลบไปแล้ว
  changes    String?     @db.Text // JSON: [{ field, label, from, to }]
  userId     Int // ผู้กระทำ
  user       User        @relation(fields: [userId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ประเด็นงาน (Civic Space, งานสื่อสาร, ชุมชนหัวใจเพชร ฯลฯ) — แอดมินจัดการได้
model WorkCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  logo        String? // path ใต้ uploads/ เช่น "category-logos/1-1727.webp" → แสดงผ่าน /api/files/ (แทนหมุดสีบนแผนที่)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities    Activity[]
  subCategories WorkSubCategory[]
}

// ประเด็นย่อยภายใต้ประเด็นงาน เช่น งานบุญประเพณี › งานศพปลอดเหล้า (แอดมินเพิ่ม/แก้เอง, ไม่มี delete — ปิด isActive แทน)
// เป็นรายการให้เลือก ไม่ใช่ tag พิมพ์อิสระ เพื่อให้สะกดตรงกันทั้งระบบ (บทเรียนจาก Google Sheet เดิม)
model WorkSubCategory {
  id         Int          @id @default(autoincrement())
  categoryId Int
  category   WorkCategory @relation(fields: [categoryId], references: [id])
  name       String
  logo       String? // โลโก้เฉพาะประเด็นย่อย (เช่น งานศพปลอดเหล้า) — แผนที่ใช้ก่อนโลโก้ของประเด็นหลัก
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  activities Activity[]

  @@unique([categoryId, name])
}

// ระดับนโยบาย/ข้อตกลงที่เกิดจากงาน (ติ๊กได้หลายระดับ)
enum PolicyLevel {
  VILLAGE // หมู่บ้าน/ชุมชน
  SUBDISTRICT // ตำบล
  DISTRICT // อำเภอ
  PROVINCE // จังหวัด
  NATIONAL // ประเทศ
}

// ความละเอียดของวันเริ่ม — ข้อมูลเก่า/สำรวจมักรู้แค่ปี ("เริ่มปี 2562") เก็บเป็น 1 ม.ค. ของปีนั้น + YEAR
enum DatePrecision {
  DAY
  YEAR
}

// ขอบเขตพื้นที่ของงาน — ตำบลที่เลือกยังบังคับ (ใช้เป็นจุดอ้างอิง/ภาค) แต่งานอาจครอบคลุมทั้งอำเภอ/จังหวัด
enum AreaScope {
  VILLAGE // หมู่บ้าน/ชุมชน (ชื่ออยู่ใน areaName)
  SUBDISTRICT // ตำบล (ค่าเริ่มต้น)
  DISTRICT // ทั้งอำเภอ
  PROVINCE // ทั้งจังหวัด
}

enum ActivityStatus {
  PLANNING // วางแผน
  ACTIVE // กำลังดำเนินการ (กิจกรรมต่อเนื่อง)
  COMPLETED // เสร็จสิ้น
}

enum LocationSource {
  TAMBON // server คำนวณจากตำบล (ค่าเริ่มต้น)
  PIN // ผู้ใช้ลาก/คลิกหมุดบนแผนที่
  GPS // ตำแหน่งปัจจุบันจากอุปกรณ์
  LINK // วางลิงก์ Google Maps หรือพิกัด
  PLACE // เลือกจากผลค้นหาสถานที่ (GISTDA Sphere)
}

// การดำเนินงาน 1 รายการ = ใคร + ประเด็นอะไร + พื้นที่ไหน + สถานะ
model Activity {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text

  categoryId Int
  category   WorkCategory @relation(fields: [categoryId], references: [id])
  // ประเด็นย่อย (ไม่บังคับ) — ต้องเป็นของ categoryId เดียวกัน (server ตรวจ)
  subCategoryId Int?
  subCategory   WorkSubCategory? @relation(fields: [subCategoryId], references: [id])
  userId     Int
  user       User         @relation(fields: [userId], references: [id])

  // พื้นที่ — auto-fill จาก TambonSearch (ข้อมูลอ้างอิง app/data/regions.ts)
  areaName  String? // ชื่อชุมชน/หมู่บ้าน/โรงเรียน
  district  String // ตำบล
  amphoe    String // อำเภอ
  province  String // จังหวัด
  areaScope AreaScope @default(SUBDISTRICT) // งานครอบคลุมแค่ไหน (หมุดของอำเภอ/จังหวัด = จุดกลางอำเภอ/จังหวัด)
  region    String // โซนพื้นที่ (HealthZone slug เช่น "north-upper" — server คำนวณจากจังหวัด, ดู app/utils/healthZones.ts)
  zipcode   String?
  latitude  Float?
  longitude Float?
  // ที่มาของพิกัด — TAMBON = จุดกลางตำบล (โดยประมาณ), อื่น ๆ = ผู้ใช้ปักหมุดตำแหน่งจริง
  locationSource LocationSource @default(TAMBON)

  // ผลลัพธ์/ภาคี (ไม่บังคับ)
  participantCount Int? // จำนวนผู้เข้าร่วม/ผู้ได้รับประโยชน์
  partners         Json? // string[] จากรายการ PARTNER_OPTIONS (lib/activityMeta.ts)
  // นโยบาย/ข้อตกลงรายระดับ → ตาราง ActivityPolicy (เดิมเป็น JSON policyLevels/policyDetails — ย้าย ก.ย. 2026)
  policies         ActivityPolicy[]
  // มีแบบสำรวจ (ติ๊กได้โดยไม่แนบไฟล์) — ไฟล์แบบสำรวจ = ActivityAttachment.isSurvey
  hasSurvey        Boolean          @default(false)
  // ความครอบคลุมของพื้นที่ (ไม่บังคับ) — ต่างจาก participantCount ที่นับคนเข้าร่วมกิจกรรม
  coverageVillages   Int?
  coverageHouseholds Int?
  coveragePopulation Int?

  // ผู้ประสานงานในพื้นที่ (คนนอกระบบ) — เบอร์/LINE เห็นเฉพาะแอดมิน + เจ้าของงาน, ห้ามขึ้นหน้าสาธารณะ (PDPA)
  coordinatorName    String?
  coordinatorRole    String? // เช่น ผู้ใหญ่บ้าน, เจ้าอาวาส, ผอ.รพ.สต.
  coordinatorPhone   String?
  coordinatorLine    String?
  coordinatorConsent Boolean @default(false) // ยินยอมให้บันทึกช่องทางติดต่อ — บังคับเมื่อกรอกเบอร์/LINE

  // เผยแพร่เป็นกรณีศึกษาสาธารณะ (/stories/[id], ไม่ต้อง login) — แอดมินกดเผยแพร่ได้เลย (ผู้ใช้ตัดสินใจ ก.ย. 2026)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  publishedById Int? // แอดมินที่กดเผยแพร่ (ไม่ทำ relation — ดูชื่อจาก audit log)
  storyLead     String?   @db.Text // บริบท/ปัญหา (ว่าง = ใช้ description)
  storyProcess  String?   @db.Text // กระบวนการทีละขั้น
  storyLessons  String?   @db.Text // ปัจจัยสำเร็จ / ข้อควรระวัง
  // ชุดกรณีศึกษา (ไม่บังคับ) — หลายเรื่องที่อ่านต่อกันได้ เช่น "สงกรานต์ 6 พื้นที่ต้นแบบ 2569" · 1 เรื่องอยู่ได้ 1 ชุด
  seriesId      Int?
  series        StorySeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesOrder   Int          @default(0) // ลำดับในชุด (น้อย = ก่อน)

  status    ActivityStatus @default(ACTIVE)
  startDate DateTime?
  startDatePrecision DatePrecision @default(DAY)
  endDate   DateTime? // null = ยังดำเนินการต่อเนื่อง

  attachments ActivityAttachment[]
  // ลิงก์ภายนอก (โพสต์ FB, คลิป YouTube, ไฟล์ใน Drive, ข่าว) — แทนการอัปไฟล์ใหญ่/เนื้อหาที่อยู่ที่อื่นแล้ว
  links       ActivityLink[]
  // พื้นที่ที่เกี่ยวข้อง (ไม่บังคับ) — งานเดียวที่ยกหลายพื้นที่ เช่น งานสื่อสารประเด็นงานศพที่เล่าต้นแบบหลายจังหวัด
  // เป็นหมุดรองบนแผนที่ + รายการในหน้า detail/กรณีศึกษา แต่สถิติ/ภาค/พื้นที่ทับซ้อนยังนับจากพื้นที่หลักด้านบน
  areas       ActivityArea[]
  // ทีมงานร่วม (งานเป็นงานทีม — ผู้ใช้ตัดสินใจ ก.ย. 2026) — userId ด้านบน = ผู้เขียน/หัวหน้างาน
  members     ActivityMember[]

  // ถังขยะ (soft delete) — ลบแล้วซ่อนทุกหน้า กู้คืนได้ 30 วัน จากนั้นลบถาวรพร้อมไฟล์
  // query ทั่วไปกรอง deletedAt: null ให้อัตโนมัติใน app/lib/db.ts
  deletedAt   DateTime?
  deletedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isPublished])
  @@index([seriesId])
  @@index([province])
  @@index([province, amphoe, district])
  @@index([region])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

// ทีมงานร่วมของงาน — เห็นใน "งานของฉัน" และแก้ไขงานได้เหมือนผู้เขียน (เปลี่ยนผู้เขียนยังเป็นสิทธิ์ superadmin)
model ActivityMember {
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  addedAt    DateTime @default(now())

  @@id([activityId, userId])
  @@index([userId])
}

// นโยบาย/ข้อตกลงที่เกิดจากงาน — 1 แถวต่อ 1 ระดับ (ติ๊กระดับในฟอร์ม = มีแถว, ชื่อ/ประเภท/ปีไม่บังคับ)
// แยกตารางเพื่อให้นับ/กรองได้ด้วย SQL เช่น "กี่ตำบลมีธรรมนูญงานศพ ประกาศปีไหน"
// ไฟล์ของนโยบาย = ActivityAttachment ที่ policyLevel ตรงกับ level ของงานเดียวกัน
model ActivityPolicy {
  id         Int         @id @default(autoincrement())
  activityId Int
  activity   Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  level      PolicyLevel
  name       String?     @db.VarChar(300) // ชื่อนโยบาย เช่น "บุญเมืองยศ งานศพปลอดเหล้า"
  type       String?     @db.VarChar(100) // จาก POLICY_TYPES (lib/activityMeta.ts)
  year       Int? // ปีที่เริ่มประกาศ (พ.ศ.)
  createdAt  DateTime    @default(now())

  @@unique([activityId, level])
  @@index([level])
  @@index([type])
  @@index([year])
}

// ชนิดลิงก์ — ระบบเดาจากโดเมนให้เอง (lib/activityLinks.ts) ใช้เลือกไอคอน/กรอง เช่น "งานไหนมีคลิป"
enum LinkKind {
  FACEBOOK
  YOUTUBE
  TIKTOK
  DRIVE // Google Drive/Docs/Sheets/Slides
  WEB // ข่าว/เว็บทั่วไป
}

// ชุดกรณีศึกษา — แอดมินจัดที่หน้าเผยแพร่ · หน้า /stories/series/[id] + กล่อง "อ่านต่อในชุดนี้" ท้ายแต่ละเรื่อง
// ชุดที่ไม่เหลือเรื่องถูกลบอัตโนมัติตอนบันทึกหน้าเผยแพร่
model StorySeries {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(200)
  description String?    @db.Text // บทนำสั้น ๆ ของทั้งชุด
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// พื้นที่ที่เกี่ยวข้องของงาน (นอกเหนือพื้นที่หลักใน Activity) — ฟิลด์ตำแหน่งชุดเดียวกับ Activity
// server ตรวจตำบลกับ regions.ts + หมุดต้องอยู่ในจังหวัด เหมือนพื้นที่หลัก · ลบงาน = ลบตาม (cascade)
model ActivityArea {
  id             Int            @id @default(autoincrement())
  activityId     Int
  activity       Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  areaName       String?        @db.VarChar(200)
  district       String
  amphoe         String
  province       String
  region         String // HealthZone slug จากจังหวัด (server คำนวณ)
  zipcode        String?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource @default(TAMBON)
  note           String?        @db.VarChar(200) // บทบาทของพื้นที่ในงานนี้ เช่น "พื้นที่ต้นแบบ ประหยัด 990,000 บาท"
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([activityId])
  @@index([province, amphoe, district])
}

// ลิงก์ที่เกี่ยวข้องกับงาน — สูงสุด 10 ลิงก์ต่องาน, รับเฉพาะ http(s)
model ActivityLink {
  id         Int      @id @default(autoincrement())
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  url        String   @db.VarChar(2000)
  title      String?  @db.VarChar(200) // ชื่อสั้น ๆ ที่ผู้ใช้พิมพ์ (ไม่บังคับ — ว่าง = แสดงโดเมน)
  kind       LinkKind @default(WEB)
  sortOrder  Int      @default(0)
  // แสดงบนหน้ากรณีศึกษาสาธารณะ (แอดมินติ๊กเองเหมือนไฟล์ isPublic)
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([activityId])
  @@index([kind])
}

enum AttachmentKind {
  DOCUMENT // ไฟล์นโยบาย/เอกสาร
  IMAGE // รูปภาพกิจกรรม
}

model ActivityAttachment {
  id         Int            @id @default(autoincrement())
  activityId Int
  activity   Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  kind       AttachmentKind
  filePath   String // path ภายใต้ uploads/ (serve ผ่าน /api/files)
  fileName   String // ชื่อไฟล์เดิมที่ผู้ใช้อัปโหลด
  mimeType   String
  size       Int
  caption    String? // คำบรรยายใต้รูป (IMAGE)
  isCover    Boolean        @default(false) // รูปปกของงาน (IMAGE ได้แค่ 1 รูปต่องาน)
  // ไฟล์นโยบาย/ข้อตกลงระดับนี้ (PDF/Word/รูปถ่ายเอกสาร) — null = ไฟล์แนบทั่วไป
  // ไม่นับรวมเพดานรูป 5 รูป และไม่ขึ้นในแกลเลอรีรูปกิจกรรม
  policyLevel PolicyLevel?
  // ไฟล์แบบสำรวจ (Activity.hasSurvey) — แยกจากไฟล์ทั่วไปเหมือนไฟล์นโยบาย · อาจมีข้อมูลผู้ตอบ ไม่เปิดเผยเป็นค่าเริ่มต้น
  isSurvey    Boolean        @default(false)
  // เปิดให้หน้าสาธารณะใช้ได้ (แอดมินติ๊กเองทีละไฟล์ — รูปคน/เด็กต้องได้รับอนุญาตก่อน) ผ่าน /api/public-files/[id]
  isPublic    Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([activityId])
}

// สถิติการใช้ "ส่งด้วยใจ" (/farewell) แบบไม่ระบุตัวตน — แอดมินดูที่ /dashboard/farewell (ผู้ใช้ตัดสินใจ 2 ต.ค. 2026)
// เก็บแค่ชนิดเหตุการณ์ + จังหวัด/ภาค + ตัวเลือกในแผน (รหัสตัวเลือก) — ห้ามเก็บชื่อผู้วายชนม์/ตำบล/ราคา/IP/อุปกรณ์
enum FarewellEventType {
  VISIT // เปิดหน้า /farewell (1 ครั้งต่อแท็บ)
  JOURNEY_VIEW // เปิดหน้า 3D เส้นทางสุดท้าย
  PLAN_START // ผ่านขั้นแรกของแผน
  PLAN_COMPLETE // ถึงหน้าสรุปแผน (1 ครั้งต่อแผน)
  PRINT // พิมพ์สรุปแผน
  SHARE // แชร์ผ่านเมนูมือถือ
  LINE // ส่งทาง LINE
  COPY // คัดลอกข้อความ
  SIGN_DOWNLOAD // ดาวน์โหลดป้ายหน้างาน
  SIGN_PRINT // พิมพ์ป้าย
  LOCAL_LOOKUP // ค้นข้อตกลงในพื้นที่ (found = พบข้อตกลงครอบคลุมตำบลนั้น)
}

model FarewellEvent {
  id        Int               @id @default(autoincrement())
  type      FarewellEventType
  province  String?           @db.VarChar(100)
  region    String?           @db.VarChar(40) // HealthZone slug — server คำนวณจากจังหวัด
  answers   Json? // PLAN_COMPLETE: { days: '1', alcohol: 'none', ... } เฉพาะรหัสตัวเลือกที่มีจริง
  found     Boolean? // LOCAL_LOOKUP
  createdAt DateTime          @default(now())

  @@index([type, createdAt])
}
